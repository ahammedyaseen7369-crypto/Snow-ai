{
  "expo": {
    "name": "Snow AI",
    "slug": "snow-ai",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#080b10",
    "splash": {
      "backgroundColor": "#080b10"
    },
    "android": {
      "package": "com.snowai.ultralite",
      "usesCleartextTraffic": true,
      "backgroundColor": "#080b10",
      "permissions": [
        "RECORD_AUDIO",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ad4a208f-ec07-436d-b35f-da167eaa2dca"
      }
    },
    "owner": "yaseen37s-personal"
  }
}
